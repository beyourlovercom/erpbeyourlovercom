worker_processes 1;
pid /Users/a/AI/production/erp.beyourlover.com/runtime/nginx-origin.pid;
error_log /Users/a/AI/production/erp.beyourlover.com/logs/nginx-origin-error.log warn;

events {
    worker_connections 128;
}

http {
    access_log /Users/a/AI/production/erp.beyourlover.com/logs/nginx-origin-access.log;
    include /opt/homebrew/etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    server {
        listen 127.0.0.1:18080;
        server_name erp.beyourlover.com;
        root /Users/a/AI/production/erp.beyourlover.com/current/public;
        index index.php;
        client_max_body_size 32m;

        set_real_ip_from 127.0.0.1;
        real_ip_header CF-Connecting-IP;
        real_ip_recursive on;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            try_files $uri =404;
            include /opt/homebrew/etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
            fastcgi_param HTTPS on;
            fastcgi_param HTTP_X_FORWARDED_PROTO https;
            fastcgi_pass unix:/Users/a/AI/production/erp.beyourlover.com/runtime/php-fpm.sock;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
