{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "byl.blue-label.job.v1",
  "title": "BYL Blue Label Job V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "plan_reference",
    "plan_snapshot_checksum",
    "template_version",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "byl.blue-label.job.v1" },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "plan_reference": { "type": "string", "minLength": 1, "maxLength": 128 },
    "plan_snapshot_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_version": { "const": "blue-label-picture-master-v1" },    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_sku",
          "label_sku",
          "label_description",
          "restock_qty"
        ],
        "properties": {
          "product_sku": { "type": "string", "minLength": 1, "maxLength": 128 },
          "label_sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "maxLength": 128
          },
          "label_description": { "type": "string", "minLength": 1, "maxLength": 512 },
          "restock_qty": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
