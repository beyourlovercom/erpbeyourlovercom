+export function resolveCanonicalPage(value: string): string | undefined {
+  if (!value.startsWith("/") || value.startsWith("//") || /[\\\u0000-\u001f]/.test(value)) return;
+  const q = value.indexOf("?");
+  const pathname = q < 0 ? value : value.slice(0,q);
